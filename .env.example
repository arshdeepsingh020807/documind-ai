# Required. The key must match the provider below: an OpenAI key (sk-...) for OpenAI,
# or an OpenRouter key (sk-or-...) when OPENAI_BASE_URL points at OpenRouter.
OPENAI_API_KEY=your_api_key

# Leave unset to use OpenAI. For OpenRouter, uncomment these and use its model names
# (check openrouter.ai/models for the exact ids):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-5-mini
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Models. EMBEDDING_DIMENSION must match EMBEDDING_MODEL
# (text-embedding-3-small = 1536, text-embedding-3-large = 3072).
OPENAI_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Storage
UPLOAD_DIRECTORY=uploads
DOCUMENT_STORE_FILE=data/document.json
VECTOR_STORE_DIRECTORY=data/vector_store

# Limits and chunking (chunk sizes are in words)
MAX_UPLOAD_MB=25
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Only needed when the frontend runs on another origin (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
