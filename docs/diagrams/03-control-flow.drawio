geometry"></mxGeometry></mxCell><mxCell id="ok" value="Return 200: answer + sources" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#e9f6e9;strokeColor=#46a758;fontColor=#203c25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="1370" width="290" height="44" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a4944;strokeWidth=1.5;fontSize=11;fontColor=#33322f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="build" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note1" value="&lt;b&gt;Why the numbers matter&lt;/b&gt;&lt;br&gt;The model is told to cite passages as [n]. The web app only turns a [n] into a chip if n is one of the sources returned here, so an invented number stays plain text." style="shape=note;size=14;align=left;spacingLeft=10;verticalAlign=middle;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#fff7c2;strokeColor=#e2a336;fontColor=#4f3422;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="940" width="360" height="100" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a4944;strokeWidth=1.5;fontSize=11;fontColor=#33322f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;dashed=1;strokeColor=#8d8d86;" edge="1" parent="1" source="prompt" target="note1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Rounded: start / end&lt;br&gt;Rectangle: step&lt;br&gt;Diamond: decision&lt;br&gt;Double-bar box: calls the AI provider&lt;br&gt;Red: error path&lt;br&gt;Amber end: normal reply, no sources" style="shape=note;size=14;align=left;spacingLeft=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#f1f0ef;strokeColor=#8d8d86;fontColor=#21201c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1500" width="270" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram>
