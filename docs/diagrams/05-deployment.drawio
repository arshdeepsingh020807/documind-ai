<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="DocuMind diagrams" version="24.0.0">
<diagram name="Deployment" id="deployment"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="880" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;DocuMind: deployment view (as deployed on Render)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=22;align=left;fontColor=#21201c;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1340" height="30" as="geometry"/></mxCell><mxCell id="c3" value="How code gets from GitHub to a running site, and what runs inside it. Dashed boxes are optional or external." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;fontColor=#53534f;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1340" height="22" as="geometry"/></mxCell><mxCell id="dev" value='&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;git push to main&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#8d8d86;fontColor=#21201c;" vertex="1" parent="1"><mxGeometry x="30" y="125" width="150" height="64" as="geometry"/></mxCell><mxCell id="gh" value='&lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;arshdeepsingh020807/documind-ai&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#f1f0ef;strokeColor=#8d8d86;fontColor=#21201c;" vertex="1" parent="1"><mxGeometry x="250" y="125" width="200" height="64" as="geometry"/></mxCell><mxCell id="c6" value="git push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a4944;strokeWidth=1.5;fontSize=11;fontColor=#33322f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev" target="gh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="render" value="Render web service" style="rounded=1;arcSize=2;dashed=0;dashPattern=8 5;fillColor=none;strokeColor=#3e63dd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#1f2d5c;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="640" height="760" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;Docker build&lt;/b&gt; (the repo's Dockerfile, two stages)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1. node:22 builds the React app into frontend/dist&lt;br&gt;2. python:3.13-slim installs requirements, copies the API and frontend/dist&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#8d8d86;fontColor=#21201c;" vertex="1" parent="1"><mxGeometry x="545" y="140" width="590" height="76" as="geometry"/></mxCell><mxCell id="c9" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a4944;strokeWidth=1.5;fontSize=11;fontColor=#33322f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gh" target="build"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="proxy" value='&lt;b&gt;Render edge&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;HTTPS, forwards to the container port&lt;br&gt;health check path: /health&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#8d8d86;fontColor=#21201c;" vertex="1" parent="1"><mxGeometry x="545" y="260" width="250" height="76" as="geometry"/></mxCell><mxCell id="c11" value="image starts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a4944;strokeWidth=1.5;fontSize=11;fontColor=#33322f;labelBackgroundColor=#ffffff;exitX=0.212;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="build" target="proxy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctr" value="Container (python:3.13-slim)" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 5;fillColor=none;strokeColor=#46a758;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#203c25;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="545" y="370" width="590" height="350" as="geometry"/></mxCell><mxCell id="api" value='&lt;b&gt;FastAPI app&lt;/b&gt; (uvicorn main:app --host 0.0.0.0 --port $PORT)&lt;br&gt;&lt;font style="font-size:11px"&gt;/documents: upload · process · chat · list · file · preview · delete&lt;br&gt;/health · CORS&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#e9f6e9;strokeColor=#46a758;fontColor=#203c25;" vertex="1" parent="1"><mxGeometry x="565" y="410" width="550" height="76" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a4944;strokeWidth=1.5;fontSize=11;fontColor=#33322f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="proxy" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="spa" value='&lt;b&gt;React app&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;built files served by the same process:&lt;br&gt;/ landing · /library · /d/&amp;lt;id&amp;gt; chat&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#e9f6e9;strokeColor=#46a758;fontColor=#203c25;" vertex="1" parent="1"><mxGeometry x="565" y="520" width="265" height="80" as="geometry"/></mxCell><mxCell id="svc" value='&lt;b&gt;Services (in process)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;PyMuPDF text and page images&lt;br&gt;chunking · FAISS search · prompt builder&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#e9f6e9;strokeColor=#46a758;fontColor=#203c25;" vertex="1" parent="1"><mxGeometry x="850" y="520" width="265" height="80" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a4944;strokeWidth=1.5;fontSize=11;fontColor=#33322f;labelBackgroundColor=#ffffff;exitX=0.24;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="api" target="spa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a4944;strokeWidth=1.5;fontSize=11;fontColor=#33322f;labelBackgroundColor=#ffffff;exitX=0.758;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="api" target="svc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="disk" value='&lt;b&gt;Local disk&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;uploads/ · data/document.json · data/vector_store/&lt;br&gt;Free plan: lost on restart or redeploy&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#f1f0ef;strokeColor=#8d8d86;fontColor=#21201c;" vertex="1" parent="1"><mxGeometry x="565" y="630" width="290" height="76" as="geometry"/></mxCell><mxCell id="pdisk" value='&lt;b&gt;Persistent disk&lt;/b&gt; (paid plans)&lt;br&gt;&lt;font style="font-size:11px"&gt;optional, mounted at /var/data;&lt;br&gt;point the three storage paths at it&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#fff7c2;strokeColor=#e2a336;fontColor=#4f3422;dashed=1;" vertex="1" parent="1"><mxGeometry x="875" y="630" width="240" height="76" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a4944;strokeWidth=1.5;fontSize=11;fontColor=#33322f;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="svc" target="disk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="env" value='&lt;b&gt;Environment variables&lt;/b&gt; (set in the Render dashboard)&lt;br&gt;&lt;font style="font-size:11px"&gt;OPENAI_API_KEY (secret) · OPENAI_BASE_URL (optional) · OPENAI_MODEL&lt;br&gt;EMBEDDING_MODEL · EMBEDDING_DIMENSION · MAX_UPLOAD_MB&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#8d8d86;fontColor=#21201c;dashed=1;" vertex="1" parent="1"><mxGeometry x="545" y="750" width="590" height="76" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Visitor's web browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;runs the React app&lt;br&gt;keeps chat history in localStorage&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#edf2fe;strokeColor=#3e63dd;fontColor=#1f2d5c;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="230" height="84" as="geometry"/></mxCell><mxCell id="c24" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a4944;strokeWidth=1.5;fontSize=11;fontColor=#33322f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="proxy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;i&gt;pages, API calls and PDF page previews&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;fontColor=#53534f;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="230" height="36" as="geometry"/></mxCell><mxCell id="ai" value='&lt;b&gt;AI provider&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;OpenAI or OpenRouter&lt;br&gt;embeddings + chat&lt;br&gt;API key from the&lt;br&gt;environment&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#8d8d86;fontColor=#21201c;dashed=1;" vertex="1" parent="1"><mxGeometry x="1225" y="505" width="155" height="120" as="geometry"/></mxCell><mxCell id="c27" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a4944;strokeWidth=1.5;fontSize=11;fontColor=#33322f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc" target="ai"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid box: always present&lt;br&gt;Dashed box: optional or external&lt;br&gt;Green: runs in the container&lt;br&gt;Amber: paid-plan option" style="shape=note;size=14;align=left;spacingLeft=10;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#f1f0ef;strokeColor=#8d8d86;fontColor=#21201c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="240" height="100" as="geometry"/></mxCell><mxCell id="c29" value="&lt;i&gt;The same container image runs anywhere Docker runs, for example an AWS EC2 instance. Only the host changes: set PORT, mount a volume for uploads/ and data/, and pass the same environment variables.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;fontColor=#53534f;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="440" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
