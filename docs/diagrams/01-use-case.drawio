<diagram name="Use cases" id="use-cases"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="960" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;DocuMind: use case diagram&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=22;align=left;fontColor=#21201c;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Who can do what. Blue = what a user wants to achieve, grey = steps it always includes, amber = optional extensions." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;fontColor=#53534f;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1200" height="22" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b&gt;DocuMind&lt;/b&gt; (web application)" style="rounded=1;arcSize=2;fillColor=#fdfdfc;strokeColor=#8d8d86;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#21201c;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="760" height="830" as="geometry"/></mxCell><mxCell id="upload" value="Upload a document" style="ellipse;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#edf2fe;strokeColor=#3e63dd;fontColor=#1f2d5c;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="210" height="56" as="geometry"/></mxCell><mxCell id="sample" value="Try the sample document" style="ellipse;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=1.5;fillColor=#edf2fe;strokeColor=#3e63dd;fontColor=#1f2d5c;" vertex="1" parent="1"><mxGeometry x="290" y="220" width="210" height="56" as="geometry"/></mxCell><mxCell id="process" value='Process a document&lt;br&gt;&lt;font style="font-size:10px"&gt;(read and index it)&lt;/font&gt;' style="ellipse;html=1;whiteSpace=wrap;fontSize=